public class ZomatoTestCase2 {

	public static void main(String[] args) throws InterruptedException {
		
		 WebDriver driver = new ChromeDriver();
	        driver.manage().window().maximize();
	        driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(30));
	        driver.get("https://www.zomato.com/bangalore/delivery");
	        driver.findElement(By.xpath("//button[text()='Log in']")).click();
	        WebElement phone = driver.findElement(By.id("auth-login-ui"));
	        driver.switchTo().frame(phone);
	        driver.findElement(By.xpath("//input[@type='number']")).sendKeys("7899233303");
	        Thread.sleep(2000);
	        driver.findElement(By.xpath("//i[@class = 'sc-rbbb40-1 cLEXmC sc-re4bd0-1 bKymEa']")).click();
